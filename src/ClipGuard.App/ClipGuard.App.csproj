<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ClipGuard.Core\ClipGuard.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\clipguard.ico</ApplicationIcon>
    <!-- 介面文字（#27）：Resources/Strings.resx 是英文（中性語系），翻譯編譯成 zh-TW/ClipGuard.App.resources.dll，放在 exe 旁邊。 -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- self-contained 發行時只帶我們有翻譯的語系的 WinForms 衛星組件（zh-TW 會退到 zh-Hant），不必附 13 種語言。
         只篩框架和套件的衛星組件，不影響自己的 zh-TW/*.resources.dll。新增語系時兩邊都要加。 -->
    <SatelliteResourceLanguages>zh-Hant</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\clipguard.ico" LogicalName="ClipGuard.App.clipguard.ico" />
  </ItemGroup>

</Project>