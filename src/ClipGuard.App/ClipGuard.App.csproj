<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ClipGuard.Core\ClipGuard.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\clipguard.ico</ApplicationIcon>
    <!-- 介面文字（#27）：Resources/Strings.resx 是英文（中性語系），翻譯編譯成 zh-TW/ClipGuard.App.resources.dll，放在 exe 旁邊。 -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\clipguard.ico" LogicalName="ClipGuard.App.clipguard.ico" />
  </ItemGroup>

</Project>