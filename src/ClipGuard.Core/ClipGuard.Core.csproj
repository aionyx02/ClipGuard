<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <InternalsVisibleTo Include="ClipGuard.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 共用規則檔（#26）：內嵌進組件，執行時不讀檔、不連網。插件那邊用 tools/build-extension-rules.mjs 產生的檔案。 -->
    <EmbeddedResource Include="..\..\rules\*.json" LogicalName="ClipGuard.Rules.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
