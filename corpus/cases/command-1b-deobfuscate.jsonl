{"id": "command.1b.deob.negative-009", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "ＯＫ", "expect": {"output": "OK", "kinds": ["full_width"]}}
{"id": "command.1b.deob.negative-010", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "echo aGVsbG8= | base64 -d", "expect": {"kinds": []}}
