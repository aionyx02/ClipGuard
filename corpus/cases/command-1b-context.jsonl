{"id": "command.1b.ctx.chat-001", "area": "command", "op": "command.analyze_in", "source": "new", "input": "cmd /c dir", "args": {"context": {"source": "chat"}}, "expect": {"level": "suspicious", "risk_score": 35}}
{"id": "command.1b.ctx.terminal-001", "area": "command", "op": "command.analyze_in", "source": "new", "input": "cmd /c dir", "args": {"context": {"source": "terminal"}}, "expect": {"level": "suspicious", "risk_score": 20}}
