{
  "format": 1,
  "name": "pii-kr",
  "pack": "KR",
  "priority": 40,
  "description": "韓國個資包（#27）：住民登錄番號（YYMMDD-SNNNNNN）。2020 年 10 月以後發的號碼最後一碼是隨機的，舊的檢查碼不能拿來驗，所以只檢查日期結構，而且一定要有關鍵字（P6）。",
  "rules": [
    {
      "id": "kr-rrn",
      "kind": "national-id",
      "label": "住民登錄號碼（韓國）",
      "regex": "[0-9]{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01])[ \\-]?[1-8][0-9]{6}",
      "notPrecededBy": "[A-Za-z0-9]",
      "notFollowedBy": "[A-Za-z0-9]",
      "context": { "keywords": ["주민등록번호", "주민번호", "주민등록", "rrn", "resident registration"], "before": 32 },
      "mask": { "keepStart": 0, "keepEnd": 3, "canonical": "digits" }
    }
  ]
}
