{
  "format": 1,
  "name": "pii-cn",
  "pack": "CN",
  "priority": 40,
  "description": "中國個資包（#27）：居民身分證（18 碼，ISO 7064 MOD 11-2 檢查碼加出生日期）。檢查碼和日期結構已經夠嚴，不要求關鍵字。",
  "rules": [
    {
      "id": "cn-resident-id",
      "kind": "national-id",
      "label": "中國居民身分證號",
      "regex": "[1-8][0-9]{5} ?(?:18|19|20)[0-9]{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01]) ?[0-9]{3}[0-9Xx]",
      "notPrecededBy": "[A-Za-z0-9]",
      "notFollowedBy": "[A-Za-z0-9]",
      "validate": "cn-id",
      "mask": { "keepStart": 3, "keepEnd": 3, "canonical": "alnum-upper" }
    }
  ]
}
