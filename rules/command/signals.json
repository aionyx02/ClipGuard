      "pattern": "@\\(\\s*['\"]?-windowstyle['\"]?\\s*,\\s*['\"]?(?:1|hidden)['\"]?[\\s\\S]{0,120}?&\\s*['\"]?powershell(?:\\.exe)?['\"]?\\s+@",
      "reason": "cmd-reason-powershell"
    },
    {
