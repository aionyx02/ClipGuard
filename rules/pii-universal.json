{
  "format": 1,
  "name": "pii-universal",
  "pack": "universal",
  "priority": 50,
  "description": "通用個資包（#27，一律開啟）：信用卡（Luhn）、IBAN（mod-97）、以 + 開頭的國際電話（E.164）。排在國家包後面：同一段號碼被國家包抓到時（例如 +886 9… 的台灣手機），以國家包的標籤為準。",
  "rules": [
    {
      "id": "credit-card",
      "kind": "credit-card",
      "label": "信用卡號",
      "finder": "card-groups",
      "mask": { "keepStart": 4, "keepEnd": 4, "canonical": "digits" }
    },
    {
      "id": "iban",
      "kind": "bank-account",
      "label": "IBAN 帳號",
      "regex": "[A-Z]{2}[0-9]{2}(?: ?[A-Z0-9]{4}){2,7}(?: ?[A-Z0-9]{1,3})?",
      "notPrecededBy": "[A-Za-z0-9]",
      "notFollowedBy": "[A-Za-z0-9]",
      "validate": "iban",
      "mask": { "keepStart": 4, "keepEnd": 4, "canonical": "alnum-upper" }
    },
    {
      "id": "e164-phone",
      "kind": "phone-number",
      "label": "電話號碼（國際格式）",
      "regex": "\\+[1-9][0-9]{0,2}(?:[ .\\-]?(?:\\([0-9]{1,4}\\)|[0-9]{1,5})){1,8}",
      "notPrecededBy": "[A-Za-z0-9+]",
      "notFollowedBy": "[0-9]",
      "validate": "e164",
      "mask": { "keepStart": 3, "keepEnd": 3, "canonical": "e164" }
    }
  ]
}
